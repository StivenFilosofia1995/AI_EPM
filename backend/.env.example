# ─────────────────────────────────────────────
# Motor primario: "ollama" (local) o "groq" (Railway)
# ─────────────────────────────────────────────
PRIMARY_ENGINE=ollama

# Ollama — apunta a tu instancia local o al servicio Railway
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Groq — fallback gratuito, recomendado para Railway
# Obtén tu clave en: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Parámetros del modelo
TEMPERATURE=0.4
MAX_TOKENS=1500
MAX_HISTORY=20

# CORS (usa * para desarrollo, o lista de URLs separadas por coma en producción)
CORS_ORIGINS=*

# Puerto (Railway lo asigna automáticamente via $PORT)
PORT=8000
