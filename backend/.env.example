# ═══════════════════════════════════════════════════════════════════════════
# EPM — Consolidación Metodológica · Variables de entorno
# ═══════════════════════════════════════════════════════════════════════════
#
# ADVERTENCIA: este archivo SÍ se versiona y el repositorio es público.
# Aquí van ÚNICAMENTE marcadores de posición, nunca valores reales.
# Los valores reales van en `backend/.env` (ignorado por git) o en las
# variables de entorno de Railway.
#
# Copia este archivo:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── Modelo (solo se usa en la etapa final de análisis e ideas) ─────────────
ANTHROPIC_API_KEY=coloca-aqui-tu-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Opcional. Déjalo vacío salvo que uses un proxy o gateway propio.
ANTHROPIC_BASE_URL=

# Temperatura baja: la etapa de análisis no debe inventar.
TEMPERATURE=0.3
MAX_TOKENS=1500

# ─── Supabase ───────────────────────────────────────────────────────────────
# La service_role key SALTA el Row Level Security por diseño: quien la tenga
# lee, modifica y borra todas las tablas del proyecto. Trátala como una
# contraseña de administrador de base de datos. Nunca en este archivo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-service-role-key

# ─── Autenticación (JWT propio) ─────────────────────────────────────────────
# Genera una clave fuerte con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambias esta clave, todas las sesiones abiertas quedan invalidadas.
SECRET_KEY=genera-una-clave-aleatoria-de-al-menos-48-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=el-id-de-tu-hoja-de-calculo
GOOGLE_SHEETS_GID=0

# Opción 1 (local): ruta al archivo de credenciales de la cuenta de servicio.
# Ese archivo está en .gitignore y NO debe versionarse.
SERVICE_ACCOUNT_FILE=service_account.json

# Opción 2 (Railway): el JSON completo de la cuenta de servicio en una línea.
# Usa una sola de las dos opciones, no ambas.
GOOGLE_CREDENTIALS_JSON=

# ─── Correo ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
# 587 usa STARTTLS. Si falla, el servicio reintenta en 465 con SSL.
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=contrasena-de-aplicacion-no-la-del-correo

# ─── Aplicación ─────────────────────────────────────────────────────────────
APP_NAME=EPM — Consolidación Metodológica
PORT=8000

# Lista de orígenes separados por coma. Prohibido usar `*` en producción.
# Ejemplo: https://ai-epm.up.railway.app,http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# ─── Legado (flujo conversacional, en proceso de retiro) ────────────────────
# Estas variables solo alimentan los endpoints marcados como obsoletos
# (/api/chat, /api/form/*). Se eliminarán cuando esos endpoints se retiren.
USE_SUPABASE_MEMORY=true
MEMORY_WINDOW_MESSAGES=100
MAX_HISTORY=20
