# ═══════════════════════════════════════════════════════════════════════════
# EPM — Consolidación Metodológica · Variables de entorno
# ═══════════════════════════════════════════════════════════════════════════
#
# ADVERTENCIA: este archivo SÍ se versiona y el repositorio es público.
# Aquí van ÚNICAMENTE marcadores de posición, nunca valores reales.
# Los valores reales van en `backend/.env` (ignorado por git) o en las
# variables de entorno de Railway.
#
# Copia este archivo:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── Modelo (solo se usa en la etapa final de análisis e ideas) ─────────────
ANTHROPIC_API_KEY=coloca-aqui-tu-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Opcional. Déjalo vacío salvo que uses un proxy o gateway propio.
ANTHROPIC_BASE_URL=

# Temperatura baja: la etapa de análisis no debe inventar.
TEMPERATURE=0.3
MAX_TOKENS=1500

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. Ahí aparecen DOS claves:
#
#   anon  public   → visible por defecto.  NO ES ESTA.
#   service_role   → viene oculta, hay que revelarla.  ES ESTA.
#
# Usar la `anon` produce "permission denied for table epm_users", porque la
# migración 008 le revoca el acceso a propósito: esa tabla guarda hashes de
# contraseña. Si eso pasa, NO ejecutes el GRANT que sugiere Postgres; cambia
# la clave.
#
# La service_role SALTA el Row Level Security por diseño: quien la tenga lee,
# modifica y borra todas las tablas. Trátala como una contraseña de
# administrador de base de datos. Nunca la escribas en este archivo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-service-role-key

# ─── Cuenta inicial (solo si NO configuras Supabase) ────────────────────────
# Sin SUPABASE_URL la aplicación arranca en modo demostración, con los datos
# en memoria, y crea sola una cuenta de administrador.
#
# Si defines ADMIN_PASSWORD, esa cuenta usa esa contraseña y queda fija entre
# despliegues. Si la dejas vacía, se genera una aleatoria y aparece en los
# registros de arranque.
#
# NO escribas aquí una contraseña real: este archivo se versiona y el
# repositorio es público. En Railway va en Variables → New Variable.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Autenticación (JWT propio) ─────────────────────────────────────────────
# Genera una clave fuerte con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambias esta clave, todas las sesiones abiertas quedan invalidadas.
SECRET_KEY=genera-una-clave-aleatoria-de-al-menos-48-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Aplicación ─────────────────────────────────────────────────────────────
APP_NAME=EPM — Consolidación Metodológica
PORT=8000


# ─── Legado (flujo conversacional, en proceso de retiro) ────────────────────
# Estas variables solo alimentan los endpoints marcados como obsoletos
# (/api/chat, /api/form/*). Se eliminarán cuando esos endpoints se retiren.
USE_SUPABASE_MEMORY=true
MEMORY_WINDOW_MESSAGES=100
MAX_HISTORY=20
