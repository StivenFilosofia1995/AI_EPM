# AVISO: este archivo NO es el que se aplica en el build.
#
# Docker busca el .dockerignore en la raíz del CONTEXTO, y tanto
# railway.toml como docker-compose.yml usan `backend` como contexto.
# El archivo vigente es backend/.dockerignore.
#
# Este se conserva por si alguna vez se construye desde la raíz.

# Control de versiones
.git/
.gitignore
.gitattributes

# Credenciales y entorno — nunca deben entrar a la imagen
.env
*.env
!.env.example
service_account.json
backend/service_account.json
*-service-account.json
credentials.json
client_secret*.json
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Pruebas y herramientas de desarrollo (no se ejecutan en la imagen)
backend/tests/
requirements-dev.txt
.github/

# Documentación y artefactos locales
docs/
*.md
!README.md
*.xlsx
*.log
uploads/

# IDE y sistema operativo
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Orquestación local
docker-compose.yml
