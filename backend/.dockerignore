# Este archivo vive DENTRO del contexto de build.
#
# Docker busca el .dockerignore en la raíz del contexto, no del repositorio.
# Como railway.toml y docker-compose.yml usan `backend` como contexto, el
# .dockerignore de la raíz nunca se aplicaba y sus patrones (`backend/tests/`,
# `backend/service_account.json`) tampoco habrían coincidido con nada.

# ─── Credenciales y entorno ─────────────────────────────────────────────────
.env
*.env
!.env.example
service_account.json
*-service-account.json
credentials.json
client_secret*.json
*.pem
*.key
*.p12

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Pruebas y herramientas de desarrollo ───────────────────────────────────
# No se ejecutan dentro de la imagen.
tests/
requirements-dev.txt
pytest.ini
pyproject.toml

# ─── SQL ────────────────────────────────────────────────────────────────────
# Las migraciones se ejecutan en Supabase, no en el contenedor.
sql/

# ─── Datos y artefactos locales ─────────────────────────────────────────────
datos_demo.json
*.xlsx
*.log
uploads/

# ─── IDE y sistema operativo ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
